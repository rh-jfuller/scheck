{
  "name": "CI",
  "on": {
    "push": { "branches": ["main"] },
    "pull_request": {}
  },
  "permissions": {
    "contents": "read"
  },
  "jobs": {
    "test": {
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 10,
      "steps": [
        { "uses": "actions/checkout@v4" },
        { "run": "cargo test" }
      ]
    }
  }
}
