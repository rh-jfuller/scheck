                    "type": "matches",
                    "path": "$.referenceLocator",
                    "pattern": "^pkg:(cargo|bitnami|cocoapods|conda|cran|gem|hackage|julia|mlflow|nuget|oci|otp|pub|pypi|vcpkg|chrome-extension)/[^@?#]+/"
                  }
                }
              },
              "message": "purl type prohibits namespace but namespace segments found (TypeProhibitsNamespace)",
              "severity": "warning",
              "diagnostics": ["purl-namespace"]
            },
            {
              "kind": "assert",
              "test": {
                "type": "or",
                "left": {
                  "type": "not",
                  "inner": { "type": "equals", "path": "$.referenceType", "value": "purl" }
                },
                "right": {
                  "type": "not",
                  "inner": {
                    "type": "matches",
                    "path": "$.referenceLocator",
                    "pattern": "^pkg:(composer|cpan|huggingface|swift|vscode-extension)/[^/]+(@|\\?|$)"
                  }
                }
              },
              "message": "purl type requires a namespace but none found (TypeRequiresNamespace)",
              "severity": "warning",
              "diagnostics": ["purl-namespace"]
            }
          ]
        }
      ]
    },
    {
      "name": "cdx-checksum",
      "title": "CycloneDX component checksum/hash validation",
      "rules": [
        {
          "context": "$.components[*]",
          "checks": [
            {
              "kind": "assert",
              "test": { "type": "exists", "path": "$.hashes" },
              "message": "component should have hashes for integrity verification",
              "severity": "warning",
              "diagnostics": ["pkg-integrity"]
            },
            {
              "kind": "assert",
              "test": {
                "type": "or",
                "left": { "type": "not_exists", "path": "$.hashes" },
                "right": {
                  "type": "count",
                  "path": "$.hashes[*]",
                  "cmp": ">=",
                  "expected": 1
                }
              },
              "message": "component hashes array must not be empty",
              "diagnostics": ["pkg-integrity"]
            }
          ]
        },
        {
          "context": "$.components[*].hashes[*]",
          "checks": [
            {
              "kind": "assert",
              "test": { "type": "exists", "path": "$.alg" },
              "message": "hash entry must have alg field",
              "diagnostics": ["pkg-integrity"]
            },
            {
              "kind": "assert",
              "test": { "type": "exists", "path": "$.content" },
              "message": "hash entry must have content field",
              "diagnostics": ["pkg-integrity"]
            },
            {
              "kind": "assert",
              "test": {
                "type": "or",
                "left": { "type": "not_exists", "path": "$.content" },
                "right": {
                  "type": "matches",
                  "path": "$.content",
                  "pattern": "^[0-9a-fA-F]{32,128}$"
                }
              },
              "message": "hash content must be a hex string (32-128 chars for MD5 through SHA-512)",
              "diagnostics": ["pkg-integrity"]
            },
            {
              "kind": "assert",
              "test": {
                "type": "or",
                "left": { "type": "not_exists", "path": "$.alg" },
                "right": {
                  "type": "matches",
                  "path": "$.alg",
                  "pattern": "^(MD5|SHA-1|SHA-256|SHA-384|SHA-512|SHA3-256|SHA3-384|SHA3-512|BLAKE2b-256|BLAKE2b-384|BLAKE2b-512|BLAKE3)$"
                }
              },
              "message": "hash algorithm should be a known CycloneDX hash algorithm",
              "severity": "warning",
              "diagnostics": ["pkg-integrity"]
            }
          ]
        }
      ]
    },
    {
