{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "my-app",
    "labels": {
      "app": "my-app",
      "env": "production"
    }
  },
  "spec": {
    "containers": [
      {
        "name": "app",
        "image": "registry.example.com/my-app:v1.2.3",
        "resources": {
          "limits": {
            "memory": "256Mi",
            "cpu": "500m"
          },
          "requests": {
            "memory": "128Mi",
            "cpu": "250m"
          }
        },
        "securityContext": {
          "privileged": false
        }
      }
    ]
  }
}
