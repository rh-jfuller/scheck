            {
              "kind": "assert",
              "test": {
                "type": "or",
                "left": {
                  "type": "not",
                  "inner": { "type": "equals", "path": "$.referenceType", "value": "purl" }
                },
                "right": {
                  "type": "matches",
                  "path": "$.referenceLocator",
                  "pattern": "^pkg:"
                }
              },
              "message": "referenceLocator must use pkg: scheme (MissingScheme / InvalidScheme)",
              "diagnostics": ["purl-scheme"]
            },
            {
              "kind": "assert",
